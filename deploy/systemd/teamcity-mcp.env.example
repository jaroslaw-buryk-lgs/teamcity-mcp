# TeamCity MCP Server - service configuration
#
# Installed to /etc/teamcity-mcp/teamcity-mcp.env (0600, root-owned).
# systemd reads this file as root before dropping privileges, so the service
# account itself never needs read access to it.
#
# Apply changes with:
#   sudo systemctl reload teamcity-mcp    # TC_URL / TC_ALLOWED_URLS only
#   sudo systemctl restart teamcity-mcp   # anything else
#
# Values must be plain KEY=VALUE. systemd does not run a shell here: no command
# substitution, no variable expansion, and quotes are taken literally.

# --- Required --------------------------------------------------------------

# Which TeamCity clients reach. Not a secret. This also pins the only server a
# client may select, which is what stops X-TeamCity-Url from being used to make
# this service issue requests to arbitrary internal hosts.
TC_URL=https://teamcity.example.com

# --- Listening -------------------------------------------------------------

# 0.0.0.0 accepts connections from other machines. Use 127.0.0.1:8123 to accept
# only local connections (correct when a reverse proxy terminates TLS in front).
LISTEN_ADDR=0.0.0.0:8123

# --- Credentials -----------------------------------------------------------
#
# Deliberately no TC_TOKEN. Each user sends their own token on every request:
#
#     X-TeamCity-Token: <their own TeamCity API token>
#
# so every caller acts as themselves in TeamCity, with their own permissions and
# audit trail. Setting TC_TOKEN here would only enable the /readyz deep probe -
# it is NOT a fallback for requests that arrive without a token.
# TC_TOKEN=

# Additional TeamCity servers a client may select via the X-TeamCity-Url header.
# Comma-separated. Anything not listed here (or in TC_URL) is refused with 400.
# TC_ALLOWED_URLS=https://teamcity-staging.example.com

# --- Security --------------------------------------------------------------

# Optional outer gate. When set, every request to /mcp must also carry
#   Authorization: Bearer <hmac>
# where <hmac> is the hex digest, NOT this secret:
#   printf 'teamcity-mcp' | openssl dgst -sha256 -hmac "$SERVER_SECRET" -r
# Leaving it unset means anyone who can reach the port may use the service with
# their own TeamCity token.
# SERVER_SECRET=

# TLS. Without these the service speaks plain HTTP, so TeamCity tokens cross the
# network in cleartext - only acceptable on a network you fully trust.
# The service runs with ProtectHome and a dynamic user, so certificates must live
# somewhere it can read, such as /etc/teamcity-mcp/, and be readable by it.
# TLS_CERT=/etc/teamcity-mcp/tls/cert.pem
# TLS_KEY=/etc/teamcity-mcp/tls/key.pem

# Origins permitted to open a WebSocket. Clients that send no Origin header
# (everything that is not a browser) are always allowed.
# ALLOWED_ORIGINS=https://app.example.com

# Unsafe. Lets requests with no token act as whoever owns TC_TOKEN.
# TC_ALLOW_SERVER_TOKEN_FALLBACK=false

# Unsafe. Disables TeamCity URL pinning, turning this into an SSRF proxy.
# TC_ALLOW_ANY_URL=false

# --- Logging & tuning ------------------------------------------------------

LOG_LEVEL=info
# console is easier to read in journalctl; json suits log shipping.
LOG_FORMAT=console

# TC_TIMEOUT=30s
# TC_MAX_RESPONSE_BYTES=33554432
# TC_MAX_IDLE_CONNS_PER_HOST=32
