bin/
dist/
*.log

# Docker
.dockerignore

# Temporary files
tmp/
temp/
*.tmp

# Test artifacts
testdata/output/

# Cache directories
.cache/

# The convenience binary/symlink that `make build` drops at the repo root.
# Anchored with a leading slash: a bare "server" also matched the
# internal/server/ package directory, silently excluding new files there.
/server

# Exported by `make export-ca` for distribution to client machines. The CA root
# is public, so this is not a secret - but it is generated output and is specific
# to one host's Caddy instance, so it has no business being committed.
/caddy-root.crt
